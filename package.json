{
	"name": "notify-slack",
	"version": "0.0.0",
	"private": true,
	"description": "Send various notifications from GitHub to Slack",
	"type": "module",
	"main": "lib/main.js",
	"scripts": {
		"build": "tsc --noEmit",
		"format": "biome format --write src",
		"check": "biome check src",
		"package": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --sourcemap",
		"all": "npm run build && npm run check && npm run package"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ken-matsui/notify-slack.git"
	},
	"keywords": [
		"actions",
		"github",
		"slack"
	],
	"author": "Ken Matsui <26405363+ken-matsui@users.noreply.github.com>",
	"license": "MIT",
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@actions/github": "^9.1.1",
		"@slack/web-api": "^7.15.1",
		"toml": "^4.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@slack/types": "^2.19.0",
		"@types/node": "^25.6.0",
		"esbuild": "^0.28.0",
		"js-yaml": "^4.1.1",
		"typescript": "^6.0.3"
	}
}
